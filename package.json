{
  "name": "fashion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @fashion/web dev",
    "dev:api": "pnpm --filter @fashion/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @fashion/web build",
    "build:api": "pnpm --filter @fashion/api build",
    "start:api": "pnpm --filter @fashion/api start:prod",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @fashion/api test:e2e",
    "format": "pnpm -r format"
  }
}
