{
  "name": "fashion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@fashion/web",
    "dev:api": "turbo run dev --filter=@fashion/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@fashion/web",
    "build:api": "turbo run build --filter=@fashion/api",
    "start:api": "pnpm --filter @fashion/api start:prod",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @fashion/api test:e2e",
    "format": "pnpm -r format"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
